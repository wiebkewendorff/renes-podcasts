    "audio": "https://wdrmedien-a.akamaihd.net/media/p/public/weltweit/2026/11/19/6791fa61-adf8-4a4e-a5a5-506fe0506e14/6791fa61-adf8-4a4e-a5a5-506fe0506e14_MP3-128.mp3",
